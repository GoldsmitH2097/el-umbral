  "floors": [
    {
      "id": "prologo",
      "title": "PRÓLOGO: INSTRUCCIONES PARA NO VOLVER",
      "ambience": "void-static",
      "beats": [
        { "t": "La singularidad le está llegando.", "delay": 800 },
        { "t": "No como una noticia. Como una infección.", "stack": true },
        { "t": "Limpia. Silenciosa. Correcta.", "fx": "cadence" },
        { "t": "No se entra aquí." },
        { "t": "Se es absorbido.", "stack": true },
        { "t": "Como quien cabalga, asido a la crín de lo que no existe, para demostrar que también levanta polvo la nada." },
        { "t": "Eso." },
        { "t": "Y de eso.", "stack": true },
        { "t": "Hubo un tiempo en que pensabas." },
        { "t": "No demasiado bien. No demasiado hondo.", "stack": true },
        { "t": "Pero pensabas.", "stack": true },
        { "t": "Ahora gestionas. Deslizas. Aceptas. Repites.", "fx": "cadence" },
        { "t": "La eutanasia del pensamiento crítico no es una teoría." },
        { "t": "Es una costumbre.", "stack": true },
        { "t": "El agujero negro no está en el cielo." },
        { "t": "Está en la conducta.", "stack": true },
        { "t": "No arrasa. No muerde. No brama.", "fx": "cadence" },
        { "t": "Obtura.", "fx": "obturar", "delay": 1200 },
        { "t": "Ese es su verbo." },
        { "t": "Mientras lees esto, algo en paralelo se está cerrando. No lo notas. Ha aprendido a hacerlo sin dolor.", "scene": "close-in" },
        { "t": "La enfermedad es un cencerro esmerilado. Quien la porta arrastra siglos de existencia vana. Le dicen sociedad." },
        { "t": "Todo ha sido optimizado." },
        { "t": "Incluso el vacío.", "stack": true },
        { "t": "El individuo ha sido sustituido por su versión mejorada: el perfil. Ya no es necesario ser. Basta con parecer." },
        { "t": "Y ahí vamos." },
        { "t": "Despellejando el código como si fuera la banana primigenia que nutrió al simio.", "stack": true },
        { "t": "Porque eso somos.", "stack": true },
        { "t": "Aunque a veces dudo.", "stack": true, "fx": "whisper" },
        { "t": "El yo ha muerto." },
        { "t": "Y su epitafio ya no se escribe en piedra, sino sobre pantalla.", "stack": true },
        { "t": "Una vida entera cabe hoy en el ataúd luminoso de un perfil." },
        { "t": "Y tú… te has acomodado dentro.", "fx": "whisper" },
        { "t": "No hay alegrías." },
        { "t": "Solo sonambulismo.", "stack": true },
        { "t": "Y mucho rictus nervioso.", "stack": true },
        { "t": "Reír es otro de los nombres de la arcada." },
        { "t": "El agujero negro no te destruye." },
        { "t": "Te corrige. Te pule. Te vuelve legible.", "fx": "corrige", "stack": true },
        { "t": "Se quiebra el mineral. Se funde en la nada. Y de ahí emerge un material corrosivo que intoxica las eras." },
        { "t": "Eso eres ahora." },
        { "t": "Un compuesto estable de ausencia.", "stack": true },
        { "t": "El tiempo no pasa. Hace de guía y precursor. Te lleva. Te arrastra. Te organiza." },
        { "t": "Hasta que un día…" },
        { "t": "muy leve… muy tarde…", "stack": true, "fx": "whisper" },
        { "t": "algo dentro recuerda.", "stack": true },
        { "t": "No es esperanza." },
        { "t": "Es fricción.", "stack": true, "fx": "friccion" },
        { "t": "Y ahí, en ese punto mínimo…" },
        { "t": "entiendes.", "stack": true, "delay": 1500 },
        { "t": "No estabas mirando el vacío.", "delay": 1000 },
        { "t": "El vacío", "stack": true, "delay": 700 },
        { "t": "estaba", "stack": true, "delay": 700 },
        { "t": "aprendiendo", "stack": true, "delay": 700 },
        { "t": "tu forma.", "stack": true, "delay": 2000, "scene": "blackout" }
      ]
    },
    {
      "id": "piso-1",
      "title": "PRIMER PISO: EL SIMULACRO DE SER",
      "ambience": "casa-madrugada",
      "beats": [
        { "t": "El timbre me despierta.", "sfx": "timbre" },
        { "t": "No suena. Irrumpe.", "fx": "cut", "stack": true },
        { "t": "Abro los ojos. Estoy en mi cama. Todo está donde debe estar." },
        { "t": "Y, sin embargo, todo ha sido sustituido.", "stack": true },
        { "t": "Miro el reloj." },
        { "t": "11:11.", "fx": "clock", "sfx": "tick", "stack": true },
        { "t": "No avanza. No duda. No respira.", "fx": "cadence" },
        { "t": "Se limita a existir como existen las verdades que ya no pueden cambiarse." },
        { "t": "Ella entra." },
        { "t": "Mi mujer siempre huele bien. Incluso ahora." },
        { "t": "—¿Vas a quedarte ahí?" },
        { "t": "Asiento. O algo parecido." },
        { "t": "Su voz es dulce." },

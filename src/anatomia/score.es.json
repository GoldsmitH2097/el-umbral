        { "t": "Me levanto." },
        { "t": "Camino por el pasillo.", "stack": true },
        { "t": "La casa está intacta. Funcional. Correcta.", "fx": "cadence" },
        { "t": "Es una réplica perfecta de sí misma.", "stack": true },
        { "t": "Paso frente al espejo." },
        { "t": "Me detengo.", "stack": true },
        { "t": "Soy yo.", "fx": "mirror" },
        { "t": "Pero no exactamente.", "stack": true },
        { "t": "Hay algo en la expresión. Una obediencia limpia. Un ajuste." },
        { "t": "El rostro ya no expresa." },
        { "t": "Representa.", "stack": true },
        { "t": "El yo ha muerto. Y su epitafio ya no se escribe en piedra, sino sobre pantalla.", "voice": "void" },
        { "t": "Sostengo la mirada." },
        { "t": "Una vida entera cabe hoy en el ataúd luminoso de un perfil.", "voice": "void" },
        { "t": "Aparto los ojos." },
        { "t": "Voy al baño." },
        { "t": "Sofía está sentada. Abraza a Átomo. Respira mal.", "sfx": "breath-fail-soft" },
        { "t": "—Papá." },
        { "t": "Solo eso." },
        { "t": "Pero lo dice como si ya supiera.", "stack": true },
        { "t": "—No eres tú del todo." },
        { "t": "No respondo." },
        { "t": "Porque tiene razón.", "stack": true },
        { "t": "Mi mujer grita." },
        { "t": "—¡Gabi!", "fx": "slam" },
        { "t": "Todo se activa." },
        { "t": "Movimiento. Búsqueda. Simulación de urgencia.", "fx": "cadence", "stack": true },
        { "t": "Cajones. Armarios. Superficies.", "fx": "cadence", "stack": true },
        { "t": "No está." },
        { "t": "El inhalador no está.", "stack": true },
        { "t": "Sofía respira a golpes. El aire no entra.", "sfx": "breath-fail" },
        { "t": "Mi mujer me mira." },
        { "t": "—Haz algo." },
        { "t": "No hay nada que hacer." },
        { "t": "Pero ejecuto.", "stack": true },
        { "t": "Siempre ejecutamos.", "voice": "void" },
        { "t": "Cojo las llaves. La cartera. Un inhalador muerto. Y a Átomo." },
        { "t": "Sofía me lo da como si fuera un talismán." },
        { "t": "Lo recojo." },
        { "t": "Está caliente.", "stack": true, "sfx": "heartbeat-soft" },
        { "t": "Todo lo vivo termina delegando en objetos.", "voice": "void" },
        { "t": "Voy a salir." },
        { "t": "Me detengo frente al espejo." },
        { "t": "El reflejo ya no sonríe." },
        { "t": "Pero tampoco duda.", "stack": true },
        { "t": "Se ha adaptado.", "stack": true },
        { "t": "Abro la puerta.", "sfx": "door" },
        { "t": "El rellano está oscuro. Demasiado limpio. Demasiado correcto." },
        { "t": "Salgo." },
        { "t": "Y entiendo algo." },
        { "t": "No voy a entrar en la noche." },
        { "t": "Voy a entrar en su simulacro.", "stack": true, "delay": 1500, "scene": "blackout" }
      ]
    },
    {
      "id": "piso-2",
      "title": "SEGUNDO PISO: TECNOLOGÍAS DE LA ANGUSTIA",
      "ambience": "vestibulo-lluvia",
      "beats": [
        { "t": "Bajo la lluvia, Madrid parece una máquina lavándose las manos.", "sfx": "rain" },
        { "t": "La verja del edificio está abierta." },
        { "t": "No recuerdo haberla abierto nunca.", "stack": true },
        { "t": "Entro.", "sfx": "gate" },
        { "t": "El vestíbulo me espera." },

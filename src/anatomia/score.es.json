        { "t": "Llego al siguiente rellano." },
        { "t": "Hay una puerta doble acristalada que da paso a otro corredor. El cristal está cubierto de vaho." },
        { "t": "No recuerdo esta puerta.", "stack": true },
        { "t": "A través del vaho veo pegada a la pared una portada de periódico amarillenta. Un titular borroso. Un edificio antiguo de Madrid. Sucesos extraños. Y una hora: 11:11.", "fx": "vaho" },
        { "t": "Parpadeo.", "fx": "blink" },
        { "t": "Cuando vuelvo a mirar, no hay titular." },
        { "t": "Solo mi reflejo desfigurado sobre el vidrio.", "stack": true },
        { "t": "Empujo la puerta." },
        { "t": "Cruje.", "stack": true, "sfx": "creak-door" },
        { "t": "Entro." },
        { "t": "La angustia ya no rompe.", "voice": "void" },
        { "t": "Administra.", "voice": "void", "stack": true },
        { "t": "Y yo…", "stack": true },
        { "t": "su usuario más fiel.", "stack": true, "delay": 1200, "scene": "blackout" }
      ]

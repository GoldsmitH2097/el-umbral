        { "t": "Está en la conducta.", "voice": "void", "stack": true },
        { "t": "Mi hija se ahoga. Yo ejecuto." },
        { "t": "Mi mujer grita. Yo ejecuto.", "stack": true },
        { "t": "La lluvia cae. Yo ejecuto.", "stack": true },
        { "t": "La angustia, antes sagrada, ha sido domada." },
        { "t": "Ahora viene en pasos.", "stack": true },
        { "t": "En protocolos.", "stack": true },
        { "t": "En secuencias.", "stack": true },
        { "t": "Primer tramo. Descansillo. Segundo tramo. Descansillo.", "fx": "cadence", "sfx": "steps" },
        { "t": "Respira.", "fx": "whisper" },
        { "t": "No pienses.", "fx": "whisper", "stack": true },
        { "t": "Sigo subiendo." },
        { "t": "El edificio está a oscuras, pero cada pocos metros una bombilla enferma palpita como un órgano cansado. No ilumina. Supervisa.", "scene": "flicker", "sfx": "hum" },
        { "t": "Escucho el viento colándose por alguna ventana mal cerrada. Escucho también otra cosa.", "sfx": "wind" },
        { "t": "No sabría decir si es una voz. O un mecanismo." },
        { "t": "Metálico. Lejano. Circular.", "fx": "cadence", "stack": true },
        { "t": "Como si un engranaje inmenso girara muy dentro del edificio, donde no debería haber nada.", "sfx": "gear" },
